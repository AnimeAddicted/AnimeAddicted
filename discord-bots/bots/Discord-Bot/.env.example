# ─── Required ─────────────────────────────────────────────
# Developer Portal > your application > Bot > Reset Token
# (also turn on all 3 "Privileged Gateway Intents" on that page)
DISCORD_TOKEN=
# Your Discord user ID (right-click your name > Copy User ID). Comma-separate several.
OWNER_IDS=
# MongoDB connection string, e.g. a free cluster from https://www.mongodb.com/atlas
MONGODB_URL=mongodb+srv://user:password@cluster0.example.mongodb.net/egglord

# ─── Music (Lavalink) ─────────────────────────────────────
# The launcher starts the bundled Lavalink server (needs Java 17+) on this machine.
# These must match Lavalink/application.yml.
LAVALINK_HOST=localhost
LAVALINK_PORT=5000
LAVALINK_PASSWORD=youshallnotpass

# ─── Optional ─────────────────────────────────────────────
GENIUS_API_KEY=
AMETHYSTE_API_KEY=
EGGLORD_MASTER_TOKEN=
WEBSITE_URL=
SUPPORT_SERVER_LINK=
SUPPORT_GUILD_ID=
SUPPORT_MOD_ROLE_ID=
SUGGESTION_CHANNEL_ID=
GUILD_LOG_CHANNEL_ID=
RATE_LIMIT_CHANNEL_ID=
CONTRIBUTOR_ROLE_ID=
SUPPORT_ROLE_ID=
DEVELOPER_ROLE_ID=
# Built-in web API (dashboard). Change the port if 3000 is taken.
API_PORT=3000
API_SECURE=true
API_TOKEN=change-me
# Comma-separated command / plugin names to switch off
DISABLED_COMMANDS=
DISABLED_PLUGINS=
DEBUG=false
